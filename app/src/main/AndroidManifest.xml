<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Network needed by the system online SpeechRecognizer on most devices -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Android 11+ package visibility: required so SpeechRecognizer can discover
      RecognitionService providers (Google, MIUI, etc.). Without this, recognition
      often fails with NO_MATCH / client errors on Poco / MIUI.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.tts" />
        <package android:name="com.google.android.as" />
        <package android:name="com.xiaomi.mibrain.speech" />
    </queries>

    <application
        android:name=".VoiceApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Voice"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Voice"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Primary VoiceInteractionService – required to become default assistant -->
        <service
            android:name=".assistant.VoiceAssistantService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:label="@string/assistant_label">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- Session service referenced by the meta-data above -->
        <service
            android:name=".assistant.VoiceAssistantSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!--
          Keep RecognitionService component for manifest completeness, but it is
          no longer referenced from voice_interaction_service metadata so the
          system does not route assist listening through our Phase-2 stub.
        -->
        <service
            android:name=".assistant.VoiceRecognitionService"
            android:exported="false"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Assist entry point -->
        <activity
            android:name=".assistant.VoiceAssistantSessionActivity"
            android:exported="true"
            android:theme="@style/Theme.Voice.Assistant"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Voice"
            android:parentActivityName=".MainActivity" />

    </application>
</manifest>
