<?xml version="1.0" encoding="utf-8"?>
<!--
  Metadata for VoiceInteractionService.
  recognitionService is intentionally omitted so assist listening uses the
  system SpeechRecognizer (Google / device default) instead of our Phase-2 stub.
-->
<voice-interaction-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.feathertech.voice.assistant.VoiceAssistantSessionService"
    android:settingsActivity="com.feathertech.voice.ui.settings.SettingsActivity"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="true"
    android:supportsLocalInteraction="true" />
